  "steps": [
    {
      "atSeconds": 0,
      "text": "Open the rc-ac example from the SPICE tutorial group."
    },
    {
      "atSeconds": 21.595,
      "text": "rc-ac is the same RC network, measured in the frequency domain."
    },
    {
      "atSeconds": 26.098,
      "text": "The AC sweep uses 1 Hz to 100 kHz and 100 points per decade."
    },
    {
      "atSeconds": 32.78,
      "text": "Run the sweep. AC analysis calculates small-signal response rather than stepping through time."
    },
    {
      "atSeconds": 45.163000000000004,
      "text": "The prepared Cutoff measurement compares OUT with IN using reference gain 1."
    },
    {
      "atSeconds": 57.461000000000006,
      "text": "The cutoff is about 159.15 Hz, where the gain is 0.707 or −3.01 dB."
    },
    {
      "atSeconds": 64.19500000000001,
      "text": "Select the derived OUT / IN trace and hide the separate node voltages to plot gain directly."
    },
    {
      "atSeconds": 91.94500000000001,
      "text": "Use the chart menu to show Magnitude (dB). The frequency axis remains logarithmic."
    },
    {
      "atSeconds": 117.092,
      "text": "Switch to Phase: the output lags, passing approximately −45° at the corner frequency."
    },
    {
      "atSeconds": 142.167,
      "text": "OUT / IN expresses gain even if the input AC amplitude changes."
    }
  ],
