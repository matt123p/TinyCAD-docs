  "steps": [
    {
      "atSeconds": 0.007999999999999896,
      "text": "Start from Open Example → SPICE tutorial → divider. We will split its two resistors across sheets."
    },
    {
      "atSeconds": 22.028000000000002,
      "text": "Hide the chart panel to give the drawing more space."
    },
    {
      "atSeconds": 28.151,
      "text": "Open the selected sheet’s arrow menu and choose Rename."
    },
    {
      "atSeconds": 39.327999999999996,
      "text": "Name this sheet Power. Renaming the page does not rename its nets."
    },
    {
      "atSeconds": 50.452,
      "text": "The + button beside the sheet tabs adds a sheet to the same drawing."
    },
    {
      "atSeconds": 56.596999999999994,
      "text": "Enter Control and choose Add. The new schematic sheet is now selected."
    },
    {
      "atSeconds": 67.753,
      "text": "Move left in the tab menu changes page order without changing any electrical connections."
    },
    {
      "atSeconds": 79.011,
      "text": "You can also drag tabs: move Control before Power."
    },
    {
      "atSeconds": 85.16499999999999,
      "text": "Drag Power back to the first position to keep the supply page before its load."
    },
    {
      "atSeconds": 91.337,
      "text": "Select Power, select R2 and cut it. Its original wires and OUT label stay on Power."
    },
    {
      "atSeconds": 106.206,
      "text": "Select Control, paste R2, then click the drawing to finish placement."
    },
    {
      "atSeconds": 125.858,
      "text": "Place a Label on R2’s top pin and name it OUT. It joins the OUT-labelled wire on Power."
    },
    {
      "atSeconds": 154.362,
      "text": "Connect the lower pin to ground 0. Matching power-net names also connect across sheets."
    },
    {
      "atSeconds": 179.48499999999999,
      "text": "Switch the lower list from Symbols to Netlist to inspect the actual connections."
    },
    {
      "atSeconds": 190.74099999999999,
      "text": "OUT has both R1 and R2 in one net, even though they are on different schematic sheets."
    },
    {
      "atSeconds": 194.94299999999998,
      "text": "On Power, the wire carries OUT; sheet names and tab order do not form the connection."
    },
    {
      "atSeconds": 201.014,
      "text": "On Control, the exact same label OUT connects R2. All schematic sheets belong to one circuit."
    }
  ],
